# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git 에 올라가지 않습니다)

# 매물 폴더 (기본값: 프로젝트 폴더 안의 '매물' 폴더). 다른 곳을 쓰려면 앞의 # 을 지우고 경로를 적으세요.
# REA_DATA_DIR=D:\다른폴더\토지

# ---- LLM ----
# 앞에서부터 순서대로 시도, 모두 실패하면 규칙 기반(rule)으로 동작
# GPT 키만 있으면 openai 를 앞에 두세요.  (python main.py setup-key 가 자동으로 맞춰 줍니다)
LLM_PROVIDERS=openai,anthropic,rule
# balance = GPT 와 Claude 를 골고루 번갈아 사용 (두 키가 모두 있을 때) / order = 위에 적힌 순서대로
LLM_STRATEGY=balance
# 설명·취향 학습 같은 부가 GPT 요청의 1분당 최대 횟수 (OpenAI 분당 한도 429 방지)
LLM_OPTIONAL_PER_MIN=10
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Sonnet 4.6 을 쓰려면:  ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
# 모델 이름이 계정에 없으면 쓸 수 있는 GPT 모델로 자동 교체됩니다 (python main.py llm-check 로 확인)
OPENAI_MODEL=gpt-5.6-luna

# ---- 공공데이터 / GIS (선택) ----
# 공공데이터포털 '국토교통부_토지 매매 실거래가 자료' 인증키 (Decoding 키)
DATA_GO_KR_SERVICE_KEY=
# 시세를 조회할 지역  이름:법정동시군구코드5자리  (쉼표로 여러 개)
REA_LAWD_CODES=양평군:41830,여주시:41670
# 브이월드 지오코딩 API 키
VWORLD_API_KEY=

# ---- 선제 제안 ----
REA_PROACTIVE_THRESHOLD=70
REA_WATCH_INTERVAL=600

# ---- 웹 서비스 ----
# 관리자 화면(/admin) 비밀번호. 비워두면 관리자 화면을 쓸 수 없습니다.
REA_ADMIN_PASSWORD=
# 인터넷에 https 로 공개할 때만 1 로 바꾸세요
REA_COOKIE_SECURE=0
