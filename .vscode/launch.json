{
  // VS Code 왼쪽 '실행 및 디버그'(Ctrl+Shift+D) 에서 원하는 항목을 고르고 F5 를 누르세요.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 웹 서비스 - 샘플 데이터로 연습 (브라우저가 열림)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--data-dir", "${workspaceFolder}/sample_data/토지", "web"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🌐 웹 서비스 - 프로젝트 매물 폴더 (실제 운영)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["web"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🌐 웹 서비스 - 같은 와이파이의 휴대폰에서도 접속",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["web", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📄 매물 입력 양식(엑셀) 새로 만들기",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["template"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⓪ 관리자 비밀번호 정하기 / 바꾸기",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["set-admin-password"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⓪ GPT API 키 저장 (setup-key, 처음 한 번)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["setup-key"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⓪ GPT 연결 점검 (llm-check)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--data-dir", "${workspaceFolder}/sample_data/토지", "llm-check"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "① 터미널 상담(chat) - 샘플 데이터",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--data-dir", "${workspaceFolder}/sample_data/토지", "chat"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "② 터미널 상담(chat) - 프로젝트 매물 폴더",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["chat"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "③ 매물 수집·정제 보고서 (sync --report)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["sync", "--report"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "④ 터미널에서 한 번 추천 (recommend)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["recommend", "${input:inquiry}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⑤ 저장된 손님에게 선제 제안 (proactive)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["proactive"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⑥ 폴더 감시 + 새 매물 알림 (watch)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["watch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⑦ 테스트 실행 (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "inquiry",
      "type": "promptString",
      "description": "찾는 땅 조건",
      "default": "음성군 채광이 좋은 2억원대 땅"
    }
  ]
}
